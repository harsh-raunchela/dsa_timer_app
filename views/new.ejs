<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>Add Problem | DSA Focus</title>
</head>
<body>

  <%- include('partials/navbar', { active: 'problems' }) %>

  <div class="page page--focus">

    <h1>Add DSA Problem</h1>
    <p class="subtitle">Add a problem to your collection, then practice it under a timer.</p>

    <div class="card form-card">
      <form action="/problems" method="POST">

        <div class="field">
          <label for="title">Problem Title</label>
          <input type="text" id="title" name="title" placeholder="e.g. Two Sum" required>
        </div>

        <div class="field">
          <label>Difficulty</label>
          <div class="radio-row">
            <label class="radio-option">
              <input type="radio" name="difficulty" value="easy" required> Easy
            </label>
            <label class="radio-option">
              <input type="radio" name="difficulty" value="medium" checked> Medium
            </label>
            <label class="radio-option">
              <input type="radio" name="difficulty" value="hard"> Hard
            </label>
          </div>
        </div>

        <div class="field">
          <label for="topic">Topic</label>
          <input type="text" id="topic" name="topic" placeholder="e.g. Arrays">
        </div>

        <div class="field">
          <label for="platform">Platform</label>
          <input type="text" id="platform" name="platform" placeholder="e.g. LeetCode">
        </div>

        <div class="field" style="margin-bottom:26px;">
          <label for="problem_url">Problem URL</label>
          <input type="url" id="problem_url" name="problem_url" placeholder="https://leetcode.com/...">
        </div>

        <div class="btn-row">
          <button type="submit" class="btn btn-primary">Add Problem</button>
          <a href="/problems" class="btn btn-ghost">Cancel</a>
        </div>

      </form>
    </div>

  </div>

</body>
</html>
