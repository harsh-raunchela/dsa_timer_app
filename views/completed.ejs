<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>Completed | DSA Focus</title>
</head>
<body>

  <%- include('partials/navbar', { active: 'completed' }) %>

  <div class="page">

    <div class="section-head">
      <div>
        <h1>Completed Problems</h1>
        <p class="subtitle" style="margin-bottom:0;">Problems you've successfully solved.</p>
      </div>
      <div class="stat-card" style="min-width:120px; text-align:center;">
        <div class="stat-label">Solved</div>
        <div class="stat-value success"><%= problems.length %></div>
      </div>
    </div>

    <% if (problems.length === 0) { %>
      <div class="card empty-state" style="margin-top:24px;">
        <p>You haven't completed any problems yet.</p>
        <a href="/problems" class="btn btn-primary">Browse Problems</a>
      </div>
    <% } else { %>
      <div class="problem-list" style="margin-top:24px;">
        <% problems.forEach(problem => { %>
          <a href="/problems/<%= problem.id %>" class="card card-link problem-card">
            <div class="problem-main">
              <div class="problem-title-row">
                <h3><%= problem.title %></h3>
                <span class="status-pill status-completed"><span class="status-dot"></span>Completed</span>
              </div>
              <div class="tag-row">
                <span class="tag tag-<%= problem.difficulty %>"><%= problem.difficulty %></span>
                <span class="tag tag-plain"><%= problem.topic || "General" %></span>
                <span class="tag tag-plain"><%= problem.platform || "—" %></span>
              </div>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>

  </div>

</body>
</html>
