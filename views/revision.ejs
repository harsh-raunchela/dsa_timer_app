<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>Revision | DSA Focus</title>
</head>
<body>

  <%- include('partials/navbar', { active: 'revision' }) %>

  <div class="page">

    <div class="section-head">
      <div>
        <h1>Revision Queue</h1>
        <p class="subtitle" style="margin-bottom:0;">Problems you couldn't solve confidently. Come back and beat the clock.</p>
      </div>
      <div class="stat-card" style="min-width:120px; text-align:center; border-color: rgba(227,160,8,0.3);">
        <div class="stat-label">To Revise</div>
        <div class="stat-value revision"><%= problems.length %></div>
      </div>
    </div>

    <% if (problems.length === 0) { %>
      <div class="card empty-state" style="margin-top:24px;">
        <p>Your revision list is empty. Nice work.</p>
        <a href="/problems" class="btn btn-primary">Browse Problems</a>
      </div>
    <% } else { %>
      <div class="problem-list" style="margin-top:24px;">
        <% problems.forEach(problem => { %>
          <div class="card problem-card" style="border-left: 2px solid var(--revision);">
            <div class="problem-main">
              <div class="problem-title-row">
                <a href="/problems/<%= problem.id %>"><h3><%= problem.title %></h3></a>
                <span class="status-pill status-revision"><span class="status-dot"></span>Needs Revision</span>
              </div>
              <div class="tag-row">
                <span class="tag tag-<%= problem.difficulty %>"><%= problem.difficulty %></span>
                <span class="tag tag-plain"><%= problem.topic || "General" %></span>
                <span class="tag tag-plain"><%= problem.platform || "—" %></span>
              </div>
            </div>
            <div class="problem-actions">
              <a href="/problems/<%= problem.id %>/start?type=revision" class="btn btn-primary btn-sm">Start Revision</a>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

  </div>

</body>
</html>
