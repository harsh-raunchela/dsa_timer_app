<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>Login | DSA Focus</title>
</head>
<body>

  <div class="page page--narrow">
    <div class="auth-wrap">

      <div class="auth-brand">
        <span class="brand-mark" style="font-size:24px;">⚡</span>
        <h1 style="font-size:22px;">Welcome back</h1>
        <p style="margin:0;">Log in to pick up where you left off.</p>
      </div>

      <div class="card auth-card">
        <form action="/login" method="POST">

          <div class="field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="you@example.com" required>
          </div>

          <div class="field" style="margin-bottom:24px;">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" placeholder="••••••••" required>
          </div>

          <button type="submit" class="btn btn-primary btn-block btn-lg">Login</button>

        </form>
      </div>

      <p class="form-foot" style="margin-top:-6px;">
        Don't have an account? <a href="/register">Create one</a>
      </p>

    </div>
  </div>

</body>
</html>
