<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>Dashboard | DSA Focus</title>
</head>
<body>

  <%- include('partials/navbar', { active: 'dashboard' }) %>

  <div class="page">

    <h1>Good to see you.</h1>
    <p class="subtitle">Ready for your next problem?</p>

    <div class="stat-grid">
      <div class="stat-card">
        <div class="stat-label">Completed</div>
        <div class="stat-value success"><%= overview.completed %></div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Revision</div>
        <div class="stat-value revision"><%= overview.revision %></div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Total Attempts</div>
        <div class="stat-value"><%= overview.totalAttempts %></div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Solved Attempts</div>
        <div class="stat-value accent"><%= overview.solved %></div>
      </div>
    </div>

    <div class="card" style="margin-bottom:32px;">
      <div class="section-head" style="margin-bottom:0;">
        <h2 style="margin-bottom:0;">Success Rate</h2>
        <span class="stat-value accent" style="font-size:18px;"><%= performance.successRate %>%</span>
      </div>
      <div class="progress-track">
        <div class="progress-fill" style="width: <%= performance.successRate %>%;"></div>
      </div>
      <div class="progress-caption">
        <span>Average time: <%= performance.averageMinutes %>m <%= performance.averageSeconds %>s</span>
        <span>
          Best time:
          <% if (performance.bestTime !== null) { %>
            <%= Math.floor(performance.bestTime / 60) %>m <%= performance.bestTime % 60 %>s
          <% } else { %>
            —
          <% } %>
        </span>
      </div>
    </div>

    <div class="section-head">
      <h2 style="margin-bottom:0;">Recent Activity</h2>
    </div>

    <% if (recentSessions.length === 0) { %>
      <div class="card empty-state">
        <p>No activity yet. Start your first timed session to see it here.</p>
        <a href="/problems" class="btn btn-primary">Browse Problems</a>
      </div>
    <% } else { %>
      <div class="problem-list" style="margin-bottom:36px;">
        <% recentSessions.forEach(session => { %>
          <a href="/problems/<%= session.problem_id %>" class="card card-link problem-card">
            <div class="problem-main">
              <div class="problem-title-row">
                <h3><%= session.title %></h3>
                <% if (session.result === "solved") { %>
                  <span class="status-pill status-completed"><span class="status-dot"></span>Solved</span>
                <% } else if (session.result === "expired") { %>
                  <span class="status-pill status-expired"><span class="status-dot"></span>Expired</span>
                <% } else { %>
                  <span class="status-pill status-revision"><span class="status-dot"></span>Couldn't Solve</span>
                <% } %>
              </div>
              <div class="problem-meta">
                <%= session.session_type %> · <%= Math.floor(session.time_taken_seconds / 60) %>m <%= session.time_taken_seconds % 60 %>s · <%= session.started_at %>
              </div>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>

    <div class="btn-row">
      <a href="/problems" class="btn btn-secondary">All Problems</a>
      <a href="/problems/completed" class="btn btn-secondary">Completed</a>
      <a href="/problems/revision" class="btn btn-secondary">Revision Queue</a>
      <a href="/problems/new" class="btn btn-primary">+ Add Problem</a>
    </div>

  </div>

</body>
</html>
