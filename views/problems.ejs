<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <title>Problems | DSA Focus</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <h1>DSA Problems</h1>

    <a href="/problems/new">+ Add Problem</a>

    <hr>

    <% if (problems.length === 0) { %>

        <p>No problems added yet.</p>

    <% } else { %>

        <% problems.forEach(problem => { %>

            <div>

               <h2>
                    <a href="/problems/<%= problem.id %>">
                    <%= problem.title %>
                    </a>
                </h2>

                <p>
                    Difficulty:
                    <%= problem.difficulty %>
                </p>

                <p>
                    Topic:
                    <%= problem.topic || "Not specified" %>
                </p>

                <p>
                    Platform:
                    <%= problem.platform || "Not specified" %>
                </p>

                <p>
                    Status:
                    <%= problem.status %>
                </p>

            </div>

            <hr>

        <% }) %>

    <% } %>

</body>

</html>