<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title><%= problem.title %> | DSA Focus</title>
</head>
<body>

  <%- include('partials/navbar', { active: 'problems' }) %>

  <div class="page">

    <div class="detail-head">
      <div class="detail-title-row">
        <h1><%= problem.title %></h1>
        <% if (problem.problem_url) { %>
          <a href="<%= problem.problem_url %>" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">Open Problem ↗</a>
        <% } %>
      </div>
      <div class="tag-row">
        <span class="tag tag-<%= problem.difficulty %>"><%= problem.difficulty %></span>
        <span class="tag tag-plain"><%= problem.topic || "General" %></span>
        <span class="tag tag-plain"><%= problem.platform || "—" %></span>
      </div>
    </div>

    <div class="detail-grid">

      <div>
        <h2>Your Statistics</h2>
        <div class="stat-mini-grid">
          <div class="card stat-mini">
            <div class="stat-label">Attempts</div>
            <div class="stat-value"><%= stats.totalAttempts || 0 %></div>
          </div>
          <div class="card stat-mini">
            <div class="stat-label">Solved</div>
            <div class="stat-value success"><%= stats.solvedAttempts || 0 %></div>
          </div>
          <div class="card stat-mini">
            <div class="stat-label">Failed</div>
            <div class="stat-value" style="color:var(--danger);"><%= stats.failedAttempts || 0 %></div>
          </div>
          <div class="card stat-mini">
            <div class="stat-label">Best Time</div>
            <div class="stat-value accent">
              <% if (stats.bestTime !== null) { %>
                <%= Math.floor(stats.bestTime / 60) %>m <%= stats.bestTime % 60 %>s
              <% } else { %>
                —
              <% } %>
            </div>
          </div>
        </div>

        <h2>Attempt History</h2>
        <div class="card">
          <% if (history.length === 0) { %>
            <p style="padding:6px 0;">No completed attempts yet.</p>
          <% } else { %>
            <% history.forEach(session => { %>
              <div class="history-item">
                <div class="history-left">
                  <% if (session.result === "solved") { %>
                    <span class="status-pill status-completed"><span class="status-dot"></span>Solved</span>
                  <% } else if (session.result === "expired") { %>
                    <span class="status-pill status-expired"><span class="status-dot"></span>Expired</span>
                  <% } else { %>
                    <span class="status-pill status-revision"><span class="status-dot"></span>Couldn't Solve</span>
                  <% } %>
                  <span class="tag tag-plain"><%= session.session_type %></span>
                </div>
                <div class="history-meta">
                  <% if (session.time_taken_seconds !== null) { %>
                    <%= Math.floor(session.time_taken_seconds / 60) %>m <%= session.time_taken_seconds % 60 %>s
                    ·
                  <% } %>
                  <%= session.allowed_minutes %>m allowed
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>

      <div>
        <div class="card clock-scene">
          <span class="eyebrow">Interview Time Limit</span>
          <div class="clock-wrap clock-sm" style="--clock-color: var(--accent); margin: 4px 0;">
            <svg viewBox="0 0 200 200">
              <circle class="clock-face-ring" cx="100" cy="100" r="88" />
              <% for (let i = 0; i < 12; i++) { %>
                <line class="clock-tick <%= i % 3 === 0 ? 'major' : '' %>"
                      x1="100" y1="16" x2="100" y2="<%= i % 3 === 0 ? 24 : 21 %>"
                      transform="rotate(<%= i * 30 %> 100 100)" />
              <% } %>
            </svg>
            <div class="clock-digital">
              <span class="clock-time">
                <% if (problem.difficulty === "easy") { %>25:00
                <% } else if (problem.difficulty === "medium") { %>45:00
                <% } else { %>60:00<% } %>
              </span>
            </div>
          </div>
          <span class="clock-status">
            <%= problem.difficulty %> problem
          </span>
          <a href="/problems/<%= problem.id %>/start" class="btn btn-primary btn-block btn-lg" style="margin-top:6px;">Start Solving</a>
        </div>

        <div class="secondary-actions">
          <a href="/problems/<%= problem.id %>/edit" class="btn btn-ghost btn-sm">Edit Problem</a>
          <form action="/problems/<%= problem.id %>?_method=DELETE" method="POST"
                onsubmit="return confirm('Are you sure you want to delete this problem?');">
            <button type="submit" class="btn btn-danger-ghost btn-sm">Delete Problem</button>
          </form>
        </div>
      </div>

    </div>

  </div>

</body>
</html>
