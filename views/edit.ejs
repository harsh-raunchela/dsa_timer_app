<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Edit Problem | DSA Focus</title>

    <link rel="stylesheet" href="/style.css">

</head>

<body>

    <h1>Edit Problem</h1>

    <form action="/problems/<%= problem.id %>?_method=PATCH"
          method="POST">

        <div>

            <label for="title">
                Problem Title
            </label>

            <input
                type="text"
                id="title"
                name="title"
                value="<%= problem.title %>"
                required
            >

        </div>

        <br>

        <div>

            <label for="difficulty">
                Difficulty
            </label>

            <select
                id="difficulty"
                name="difficulty"
                required
            >

                <option
                    value="easy"
                    <%= problem.difficulty === "easy" ? "selected" : "" %>
                >
                    Easy
                </option>

                <option
                    value="medium"
                    <%= problem.difficulty === "medium" ? "selected" : "" %>
                >
                    Medium
                </option>

                <option
                    value="hard"
                    <%= problem.difficulty === "hard" ? "selected" : "" %>
                >
                    Hard
                </option>

            </select>

        </div>

        <br>

        <div>

            <label for="topic">
                Topic
            </label>

            <input
                type="text"
                id="topic"
                name="topic"
                value="<%= problem.topic || '' %>"
            >

        </div>

        <br>

        <div>

            <label for="platform">
                Platform
            </label>

            <input
                type="text"
                id="platform"
                name="platform"
                value="<%= problem.platform || '' %>"
            >

        </div>

        <br>

        <div>

            <label for="problem_url">
                Problem URL
            </label>

            <input
                type="url"
                id="problem_url"
                name="problem_url"
                value="<%= problem.problem_url || '' %>"
            >

        </div>

        <br>

        <button type="submit">
            Update Problem
        </button>

    </form>

    <br>

    <a href="/problems/<%= problem.id %>">
        Cancel
    </a>

</body>

</html>